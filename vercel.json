{
  "rewrites": [
    {
      "source": "/api/tutor-test/:path*",
      "destination": "https://luminous-classes-backend.onrender.com/api/tutor-test/:path*"
    },
    {
      "source": "/api/tutor-account/:path*",
      "destination": "https://luminous-classes-backend.onrender.com/api/tutor-account/:path*"
    },
    {
      "source": "/api/admin/tutor-accounts/:path*",
      "destination": "https://luminous-classes-backend.onrender.com/api/admin/tutor-accounts/:path*"
    },
    {
      "source": "/api/learn/:path*",
      "destination": "https://luminous-classes-backend.onrender.com/api/learn/:path*"
    },
    {
      "source": "/api/admin/learner/:path*",
      "destination": "https://luminous-classes-backend.onrender.com/api/admin/learner/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/parent",
      "destination": "/parent/index.html"
    },
    {
      "source": "/tutor",
      "destination": "/tutor/index.html"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/tutor-test",
      "destination": "/tutor-test/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/tutor-legacy",
      "destination": "/tutor-legacy/index.html"
    },
    {
      "source": "/learn",
      "destination": "/learn/index.html"
    },
    {
      "source": "/learn/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/learn/:exam",
      "destination": "/learn/:exam/index.html"
    },
    {
      "source": "/learn/:exam/:subject",
      "destination": "/learn/:exam/:subject/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}